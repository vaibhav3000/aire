{"run_id": "run_0e2fe3c1", "case_id": "plans_starter_price", "system_config": {"top_k": 1, "min_score": 0.05, "style": "faithful", "weighting": "overlap", "allow_irrelevant": false}, "started_at": 1795046301.8253212, "final_answer": "The Starter tier allows 60 requests per minute, Growth allows 300 requests per minute, and Business allows 1,200 requests per minute. [doc:doc_rate_limits] Usage is counted in rolling one-minute windows, and every response carries an X-RateLimit-Remaining header showing the remaining budget. [doc:doc_rate_limits]", "retrieved_doc_ids": ["doc_rate_limits"], "tool_calls": [], "spans": [{"kind": "generation", "name": "v1_baseline.invoke", "started_at": 1795046301.8253467, "latency_ms": 0.4096000047866255, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 16, "completion_tokens": 78, "token_source": "heuristic"}, "error": null, "trace_id": "tr_5dc025c0", "schema_version": "1.1"}
