{"run_id": "run_7a755151", "case_id": "onboarding_api_key", "system_config": {"top_k": 1, "min_score": 0.05, "style": "faithful", "weighting": "overlap", "allow_irrelevant": false}, "started_at": 1795101494.1883638, "final_answer": "Setting up Northwind Cloud takes about ten minutes. [doc:doc_onboarding] Third, open the console and generate an API key under Settings and then Keys; the secret is displayed only once, so copy it into a secure store. [doc:doc_onboarding]", "retrieved_doc_ids": ["doc_onboarding"], "tool_calls": [], "spans": [{"kind": "generation", "name": "v1_baseline.invoke", "started_at": 1795101494.1883874, "latency_ms": 0.32170000122278, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 15, "completion_tokens": 59, "token_source": "heuristic", "cache_read_tokens": null, "cache_write_tokens": null, "reasoning_tokens": null}, "error": null, "trace_id": "tr_6883201e", "schema_version": "1.2"}
