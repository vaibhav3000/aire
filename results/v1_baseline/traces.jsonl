{"run_id": "run_19329ac2", "case_id": "encryption_at_rest", "system_config": {"top_k": 1, "min_score": 0.05, "style": "faithful", "weighting": "overlap", "allow_irrelevant": false}, "started_at": 1795103053.600968, "final_answer": "All data stored on Northwind Cloud is encrypted at rest with AES-256, using keys managed by the platform key service. [doc:doc_encryption] Encryption keys rotate automatically every 90 days, and Business plan customers can trigger a manual key rotation from the console at any time. [doc:doc_encryption]", "retrieved_doc_ids": ["doc_encryption"], "tool_calls": [], "spans": [{"kind": "generation", "name": "v1_baseline.invoke", "started_at": 1795103053.6009917, "latency_ms": 0.3069000013056211, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 11, "completion_tokens": 75, "token_source": "heuristic", "cache_read_tokens": null, "cache_write_tokens": null, "reasoning_tokens": null}, "error": null, "trace_id": "tr_6ad25a81", "schema_version": "1.2"}
{"run_id": "run_19329ac2", "case_id": "onboarding_api_key", "system_config": {"top_k": 1, "min_score": 0.05, "style": "faithful", "weighting": "overlap", "allow_irrelevant": false}, "started_at": 1795103053.6021163, "final_answer": "Setting up Northwind Cloud takes about ten minutes. [doc:doc_onboarding] Third, open the console and generate an API key under Settings and then Keys; the secret is displayed only once, so copy it into a secure store. [doc:doc_onboarding]", "retrieved_doc_ids": ["doc_onboarding"], "tool_calls": [], "spans": [{"kind": "generation", "name": "v1_baseline.invoke", "started_at": 1795103053.602138, "latency_ms": 0.31239999952958897, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 15, "completion_tokens": 59, "token_source": "heuristic", "cache_read_tokens": null, "cache_write_tokens": null, "reasoning_tokens": null}, "error": null, "trace_id": "tr_4f884192", "schema_version": "1.2"}
{"run_id": "run_19329ac2", "case_id": "plans_starter_price", "system_config": {"top_k": 1, "min_score": 0.05, "style": "faithful", "weighting": "overlap", "allow_irrelevant": false}, "started_at": 1795103053.6031656, "final_answer": "The Starter tier allows 60 requests per minute, Growth allows 300 requests per minute, and Business allows 1,200 requests per minute. [doc:doc_rate_limits] Usage is counted in rolling one-minute windows, and every response carries an X-RateLimit-Remaining header showing the remaining budget. [doc:doc_rate_limits]", "retrieved_doc_ids": ["doc_rate_limits"], "tool_calls": [], "spans": [{"kind": "generation", "name": "v1_baseline.invoke", "started_at": 1795103053.6031866, "latency_ms": 0.37510000038309954, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 16, "completion_tokens": 78, "token_source": "heuristic", "cache_read_tokens": null, "cache_write_tokens": null, "reasoning_tokens": null}, "error": null, "trace_id": "tr_8416a18e", "schema_version": "1.2"}
