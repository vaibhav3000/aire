{"run_id": "run_0e2fe3c1", "case_id": "sla_standard_uptime", "system_config": {"top_k": 1, "min_score": 0.05, "style": "faithful", "weighting": "overlap", "allow_irrelevant": false}, "started_at": 1795046301.8211114, "final_answer": "Northwind Cloud guarantees 99.9% monthly uptime on the standard tier and 99.95% on the Business plan. [doc:doc_sla] The credit formula works as follows: 5% of the monthly fee for every 0.1% of downtime below the target, so credit percentage equals missed uptime divided by 0.1, multiplied by 5, capped at 50% of one monthly fee. [doc:doc_sla]", "retrieved_doc_ids": ["doc_sla"], "tool_calls": [], "spans": [{"kind": "generation", "name": "v1_baseline.invoke", "started_at": 1795046301.8211331, "latency_ms": 0.2918999962275848, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 13, "completion_tokens": 85, "token_source": "heuristic"}, "error": null, "trace_id": "tr_a37ce45a", "schema_version": "1.1"}
