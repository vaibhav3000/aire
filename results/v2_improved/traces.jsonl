{"run_id": "run_98f2f1f7", "case_id": "plans_starter_price", "system_config": {"top_k": 3, "min_score": 0.05, "style": "faithful", "weighting": "idf", "allow_irrelevant": false}, "started_at": 1795101494.2531943, "final_answer": "The Starter tier allows 60 requests per minute, Growth allows 300 requests per minute, and Business allows 1,200 requests per minute. [doc:doc_rate_limits] Usage is counted in rolling one-minute windows, and every response carries an X-RateLimit-Remaining header showing the remaining budget. [doc:doc_rate_limits]", "retrieved_doc_ids": ["doc_rate_limits", "doc_support_tiers", "doc_refunds"], "tool_calls": [], "spans": [{"kind": "generation", "name": "v2_improved.invoke", "started_at": 1795101494.2532163, "latency_ms": 0.3298999999969965, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 16, "completion_tokens": 78, "token_source": "heuristic", "cache_read_tokens": null, "cache_write_tokens": null, "reasoning_tokens": null}, "error": null, "trace_id": "tr_4d782d58", "schema_version": "1.2"}
{"run_id": "run_98f2f1f7", "case_id": "status_severities", "system_config": {"top_k": 3, "min_score": 0.05, "style": "faithful", "weighting": "idf", "allow_irrelevant": false}, "started_at": 1795101494.2542753, "final_answer": "The Northwind Cloud status page is published at status.northwind.cloud and shows real-time health for every region and for core services such as the API, console, and dashboard. [doc:doc_status_page] Incidents use three severity levels: severity 1 marks a full outage, severity 2 marks degraded performance, and severity 3 marks a minor issue without customer impact. [doc:doc_status_page]", "retrieved_doc_ids": ["doc_status_page", "doc_regions", "doc_sla"], "tool_calls": [], "spans": [{"kind": "generation", "name": "v2_improved.invoke", "started_at": 1795101494.2542932, "latency_ms": 0.2727999999478925, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 15, "completion_tokens": 97, "token_source": "heuristic", "cache_read_tokens": null, "cache_write_tokens": null, "reasoning_tokens": null}, "error": null, "trace_id": "tr_289aa272", "schema_version": "1.2"}
