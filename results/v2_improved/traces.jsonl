{"run_id": "run_98f2f1f7", "case_id": "sla_standard_uptime", "system_config": {"top_k": 3, "min_score": 0.05, "style": "faithful", "weighting": "idf", "allow_irrelevant": false}, "started_at": 1795101494.2486243, "final_answer": "Northwind Cloud guarantees 99.9% monthly uptime on the standard tier and 99.95% on the Business plan. [doc:doc_sla] The credit formula works as follows: 5% of the monthly fee for every 0.1% of downtime below the target, so credit percentage equals missed uptime divided by 0.1, multiplied by 5, capped at 50% of one monthly fee. [doc:doc_sla]", "retrieved_doc_ids": ["doc_sla", "doc_support_tiers", "doc_billing_plans"], "tool_calls": [], "spans": [{"kind": "generation", "name": "v2_improved.invoke", "started_at": 1795101494.2486434, "latency_ms": 0.3157999999530148, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 13, "completion_tokens": 85, "token_source": "heuristic", "cache_read_tokens": null, "cache_write_tokens": null, "reasoning_tokens": null}, "error": null, "trace_id": "tr_779b53eb", "schema_version": "1.2"}
