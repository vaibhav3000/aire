# AIRE environment configuration (optional).
#
# Copy to .env and fill in only if you attach a real LLM adapter.
# The committed demo results use the deterministic responder in
# src/aire/llm/deterministic.py and require NO API key and NO network
# access. Nothing in AIRE reads this variable by default; it exists as
# the conventional place for the key when you wire up an
# OpenAI-compatible system under test.

# OpenAI API key for real-LLM adapters. Leave unset for the offline demo.
AIRE_OPENAI_API_KEY=

# --- Optional: real-LLM mode (scripts/run_llm_eval.py; repo-engineer LLM planner) ---
# The key is read from the environment at call time and is never committed.
# Gemini's OpenAI-compatible endpoint is the default provider.
GEMINI_API_KEY=
# REPO_ENGINEER_LLM_PROVIDER=gemini
# REPO_ENGINEER_LLM_MODEL=gemini-2.5-flash
