# AIRE environment configuration (optional).
#
# Copy to .env and fill in only if you attach a real LLM adapter. .env is
# gitignored and dockerignored; never commit a real key.
# The committed demo results use the deterministic responder in
# src/aire/llm/deterministic.py and require NO API key and NO network
# access. Nothing in AIRE reads these variables by default; they are the
# conventional place for a key when you wire up an OpenAI-compatible
# system under test.

# OpenAI API key for real-LLM adapters. Leave unset for the offline demo.
AIRE_OPENAI_API_KEY=

# --- Optional: real-LLM mode (scripts/run_llm_eval.py) ---
# The key is read from the environment at call time and never written to
# traces, results or logs. Gemini's OpenAI-compatible endpoint is the
# default provider.
GEMINI_API_KEY=
