{"run_id": "run_19f50827", "case_id": "refunds_request_window", "system_config": {"top_k": 3, "min_score": 0.05, "weighting": "idf", "generator": "gemini-2.5-flash via OpenAI-compatible API", "temperature": 0.0}, "started_at": 1789585832.5652342, "final_answer": "Northwind Cloud grants a refund window of 30 days from the date of each charge [doc:doc_refunds]. This 30-day window restarts at every renewal date for annual plans [doc:doc_refunds].", "retrieved_doc_ids": ["doc_refunds", "doc_data_retention", "doc_rate_limits"], "tool_calls": [], "spans": [{"kind": "generation", "name": "llm_rag_gemini-2.5-flash.invoke", "started_at": 1789585832.5652342, "latency_ms": 1738.0919000024733, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 643, "completion_tokens": 49, "token_source": "api"}, "error": null, "trace_id": "tr_97941627"}
