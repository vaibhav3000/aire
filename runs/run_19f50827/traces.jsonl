{"run_id": "run_19f50827", "case_id": "status_severities", "system_config": {"top_k": 3, "min_score": 0.05, "weighting": "idf", "generator": "gemini-2.5-flash via OpenAI-compatible API", "temperature": 0.0}, "started_at": 1789585881.4086351, "final_answer": "Incidents on the Northwind Cloud status page use three severity levels: severity 1 marks a full outage, severity 2 marks degraded performance, and severity 3 marks a minor issue without customer impact [doc:doc_status_page].", "retrieved_doc_ids": ["doc_status_page", "doc_regions", "doc_sla"], "tool_calls": [], "spans": [{"kind": "generation", "name": "llm_rag_gemini-2.5-flash.invoke", "started_at": 1789585881.4086351, "latency_ms": 1911.0213000021758, "attributes": {"attempt": 1}, "error": null}], "usage": {"prompt_tokens": 620, "completion_tokens": 49, "token_source": "api"}, "error": null, "trace_id": "tr_b80e7d20"}
